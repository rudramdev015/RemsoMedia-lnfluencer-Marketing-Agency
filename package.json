{
  "name": "remso-media",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "install:all": "npm install && npm install --prefix client",
    "dev": "concurrently -n api,web -c yellow,green \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
