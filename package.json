  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1"
  }
}